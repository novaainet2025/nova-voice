{
  "name": "nova-voice",
  "version": "0.1.0",
  "description": "Cross-platform voice-to-text keyboard app powered by Whisper",
  "main": "./out/main/index.js",
  "author": "NOVA-VOICE",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "verify:core": "node scripts/verify-core-behavior.mjs",
    "verify:providers": "node scripts/verify-provider-ranking.mjs",
    "verify:stt": "node scripts/verify-stt-streaming.mjs",
    "verify:meta-ai": "node scripts/verify-meta-prompt-ai.mjs",
    "verify:mac": "node scripts/verify-installed-mac.mjs",
    "sync:commands": "node scripts/sync-cli-command-catalog.mjs",
    "package": "electron-builder",
    "package:mac": "electron-builder --mac dir --arm64 && zsh scripts/sign-mac-app.sh",
    "package:win": "electron-builder --win",
    "package:linux": "electron-builder --linux",
    "verify:latch": "node scripts/verify-front-app-latch.mjs",
    "verify:all": "npm run verify:core && npm run verify:latch && npm run verify:providers && npm run verify:stt"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "ws": "^8.21.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^3.0.0",
    "postcss": "^8.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0"
  },
  "build": {
    "appId": "com.novavoice.app",
    "productName": "NOVA VOICE",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "resources/icon.icns",
      "entitlements": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "NOVA-VOICE needs microphone access for voice-to-text transcription."
      }
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "resources/icon.png",
      "target": [
        "AppImage"
      ]
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ]
  }
}
